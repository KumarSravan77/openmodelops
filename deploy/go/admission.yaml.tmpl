apiVersion: v1
kind: ServiceAccount
metadata: {name: openmodelops-admission, namespace: openmodelops}
---
apiVersion: apps/v1
kind: Deployment
metadata: {name: openmodelops-admission, namespace: openmodelops}
spec:
  replicas: 2
  selector: {matchLabels: {app: openmodelops-admission}}
  template:
    metadata: {labels: {app: openmodelops-admission}}
    spec:
      serviceAccountName: openmodelops-admission
      securityContext: {runAsNonRoot: true, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: admission
          image: openmodelops-admission:local
          imagePullPolicy: Never
          env: [{name: TLS_CERT_FILE, value: /tls/tls.crt}, {name: TLS_KEY_FILE, value: /tls/tls.key}]
          ports: [{name: https, containerPort: 8443}]
          readinessProbe: {httpGet: {path: /healthz, port: https, scheme: HTTPS}, initialDelaySeconds: 3}
          livenessProbe: {httpGet: {path: /healthz, port: https, scheme: HTTPS}, initialDelaySeconds: 10}
          resources:
            requests: {cpu: 25m, memory: 32Mi}
            limits: {cpu: 250m, memory: 128Mi}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          volumeMounts: [{name: tls, mountPath: /tls, readOnly: true}]
      volumes: [{name: tls, secret: {secretName: openmodelops-admission-tls}}]
---
apiVersion: v1
kind: Service
metadata: {name: openmodelops-admission, namespace: openmodelops}
spec:
  selector: {app: openmodelops-admission}
  ports: [{name: https, port: 443, targetPort: https}]
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingWebhookConfiguration
metadata: {name: openmodelops-workload-policy}
webhooks:
  - name: workloads.platform.openmodelops.io
    admissionReviewVersions: [v1]
    sideEffects: None
    failurePolicy: Fail
    timeoutSeconds: 5
    matchPolicy: Equivalent
    clientConfig:
      service: {namespace: openmodelops, name: openmodelops-admission, path: /validate, port: 443}
      caBundle: __CA_BUNDLE__
    rules:
      - operations: [CREATE, UPDATE]
        apiGroups: [platform.openmodelops.io]
        apiVersions: [v1alpha1]
        resources: [modeldeployments, agentdeployments, evaluationruns]
        scope: Namespaced
